{
  "name": "ossie",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check:css-tokens": "node scripts/check-ossie-css-tokens.mjs"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "postcss": "8.5.18",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.4",
      "postcss": "8.5.18",
      "sharp": "0.35.0",
      "ws": "8.21.0"
    }
  }
}
